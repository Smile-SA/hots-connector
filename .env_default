HOTSCONNECTOR_LOG_LEVEL=INFO

# observation_backend: prometheus_docker | prometheus_kubernetes
# action_backend:      docker | kubernetes
HOTSCONNECTOR_OBSERVATION_BACKEND=prometheus_docker
HOTSCONNECTOR_TRANSPORT_BACKEND=kafka
HOTSCONNECTOR_ACTION_BACKEND=docker

HOTSCONNECTOR_PROMETHEUS_URL=http://localhost:9090

HOTSCONNECTOR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HOTSCONNECTOR_KAFKA_TOPIC_DATA=hots_data
HOTSCONNECTOR_KAFKA_TOPIC_MOVES=hots_moves
HOTSCONNECTOR_KAFKA_GROUP_ID=hots_connector
# Optional: malformed moves are published here before their offset is
# committed, instead of being silently dropped. Leave unset to disable.
#HOTSCONNECTOR_KAFKA_TOPIC_MOVES_DLQ=hots_moves_dlq
HOTSCONNECTOR_MOVES_BATCH_SIZE=50

HOTSCONNECTOR_PUBLISH_INTERVAL_SECONDS=10

# Prometheus label/query overrides. Leave unset (comment out) to use the
# profile default for the selected observation_backend -- docker labels
# (name, container_label_machine_id) shown here as the explicit default;
# for prometheus_kubernetes the profile default is (pod, node).
HOTSCONNECTOR_PROM_WORKLOAD_LABEL=name
HOTSCONNECTOR_PROM_HOST_LABEL=container_label_machine_id

HOTSCONNECTOR_PROM_QUERY_MEM_MB=sum by (name, container_label_machine_id) (container_memory_rss / (1024*1024))
HOTSCONNECTOR_PROM_QUERY_CPU=sum by (name, container_label_machine_id) (rate(container_cpu_usage_seconds_total[1m]))

HOTSCONNECTOR_DOCKER_TLS_VERIFY=false
HOTSCONNECTOR_DOCKER_HOSTS_JSON={"vm1":"tcp://192.0.2.11:2375","vm2":"tcp://192.0.2.12:2375"}

HOTSCONNECTOR_MIGRATION_STRATEGY=recreate
HOTSCONNECTOR_MIGRATION_REMOVE_SOURCE=true
HOTSCONNECTOR_MIGRATION_KEEP_NAME=true
HOTSCONNECTOR_MIGRATION_STOP_TIMEOUT_SECONDS=10
# Log the migration that would happen without touching Docker.
HOTSCONNECTOR_MIGRATION_DRY_RUN=false
HOTSCONNECTOR_MIGRATION_READY_TIMEOUT_SECONDS=30
HOTSCONNECTOR_MIGRATION_READY_POLL_SECONDS=1.0

# Kubernetes action backend (only used when ACTION_BACKEND=kubernetes)
#HOTSCONNECTOR_K8S_KUBECONFIG_PATH=/path/to/kubeconfig
#HOTSCONNECTOR_K8S_CONTEXT=kind-benchmark
HOTSCONNECTOR_K8S_NAMESPACE=default
# pod: workload_id is the pod name (matches raw telemetry identity, default).
# controller: workload_id is the Deployment name directly.
HOTSCONNECTOR_K8S_WORKLOAD_IDENTITY=pod
HOTSCONNECTOR_K8S_NODE_LABEL_KEY=kubernetes.io/hostname
HOTSCONNECTOR_K8S_READY_TIMEOUT_SECONDS=120
HOTSCONNECTOR_K8S_POLL_INTERVAL_SECONDS=2.0
# Optional: persist the nodeSelector snapshot to this path so
# restore_node_selectors() still works after a process restart/crash. Leave
# unset to keep the snapshot in-memory only (lost on restart).
#HOTSCONNECTOR_K8S_NODE_SELECTOR_SNAPSHOT_PATH=/tmp/hots-connector-selectors.json